---
import ContributionModal from '../../components/ContributionModal.astro';
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

// On récupère tous les biais au moment du build
const res = await fetch("https://api.ai-biais-initiative.org/v_api_biais_liste?select=*&order=score_ibi.desc&limit=300");
const biais = await res.json();
---

<BaseLayout title="Les 250 Biais de l'IA Documentés | AI BIAIS" description="Explorez notre base de données des 250 biais algorithmiques. Recherchez par catégorie, origine, cycle de vie ou secteur.">
  <!-- HERO -->
  <section class="relative overflow-hidden bg-ibi-night text-white">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full blur-3xl opacity-20" style="background: radial-gradient(circle, #2D46F5 0%, transparent 70%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-6 py-20 md:py-28">
      <div class="max-w-3xl">
        <p class="text-xs font-display font-semibold tracking-[0.14em] uppercase text-ibi-primary mb-6">Explorateur · 250 biais</p>
        <h1 class="font-display font-extrabold text-4xl md:text-6xl leading-tight mb-6">
          Les 250 biais <span class="text-gradient-ibi">de l'IA</span>
        </h1>
        <p class="text-lg md:text-xl text-ibi-fg3 leading-relaxed">
          Recherchez, filtrez et explorez la base de connaissances. Chaque biais est classé selon la taxonomie TriAxis et documenté avec ses métriques de détection.
        </p>
      </div>
    </div>
  </section>

  <!-- FILTRES + RECHERCHE -->
  <section class="bg-white border-b border-ibi-border sticky top-16 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 py-6">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
        <div class="md:col-span-6">
          <label class="block text-xs font-display font-semibold text-ibi-fg2 mb-1.5">&#x1F50D; Recherche</label>
          <input id="search-input" type="text" placeholder="Ex: proxy, LLM, discrimination..." class="w-full px-4 py-2.5 text-sm rounded-lg border border-ibi-border bg-white focus:border-ibi-primary focus:outline-none focus:ring-2 focus:ring-ibi-primary/20 transition-all" />
        </div>
        <div class="md:col-span-3">
          <label class="block text-xs font-display font-semibold text-ibi-fg2 mb-1.5">&#x2195; Trier par</label>
          <select id="sort-select" class="w-full px-3 py-2.5 text-sm rounded-lg border border-ibi-border bg-white focus:border-ibi-primary focus:outline-none">
            <option value="score-desc">Score (élevé → faible)</option>
            <option value="score-asc">Score (faible → élevé)</option>
            <option value="id-asc">Identifiant IBI (A→Z)</option>
            <option value="nom-asc">Nom (A→Z)</option>
          </select>
        </div>
        <div class="md:col-span-3">
          <label class="block text-xs font-display font-semibold text-ibi-fg2 mb-1.5">&#x1F4C4; Par page</label>
          <select id="limit-select" class="w-full px-3 py-2.5 text-sm rounded-lg border border-ibi-border bg-white focus:border-ibi-primary focus:outline-none">
            <option value="12">12</option>
            <option value="24" selected>24</option>
            <option value="48">48</option>
            <option value="96">96</option>
          </select>
        </div>
        <div class="md:col-span-3">
          <label class="block text-xs font-display font-semibold text-ibi-fg2 mb-1.5">&#x1F9ED; Axe Origine</label>
          <select id="filter-o" class="w-full px-3 py-2.5 text-sm rounded-lg border border-ibi-border bg-white focus:border-ibi-primary focus:outline-none">
            <option value="">Tous</option>
            <option value="O1_Systemic">O1 - Systemic</option>
            <option value="O2_computational">O2 - computational</option>
            <option value="O3_humain_cognitive">O3 - Humain-cognitive</option>
          </select>
        </div>
        <div class="md:col-span-3">
          <label class="block text-xs font-display font-semibold text-ibi-fg2 mb-1.5">&#x1F504; Axe Lifecycle</label>
          <select id="filter-l" class="w-full px-3 py-2.5 text-sm rounded-lg border border-ibi-border bg-white focus:border-ibi-primary focus:outline-none">
            <option value="">Tous</option>
            <option value="L1_historique">L1 - Historique</option>
            <option value="L2_representation">L2 - Représentation</option>
            <option value="L3_mesure">L3 - Mesure</option>
            <option value="L4_agregation">L4 - Agrégation</option>
            <option value="L5_evaluation">L5 - Évaluation</option>
            <option value="L6_deploiement">L6 - Déploiement</option>
          </select>
        </div>
        <div class="md:col-span-3">
          <label class="block text-xs font-display font-semibold text-ibi-fg2 mb-1.5">&#x26A0; Sévérité</label>
          <select id="filter-sev" class="w-full px-3 py-2.5 text-sm rounded-lg border border-ibi-border bg-white focus:border-ibi-primary focus:outline-none">
            <option value="">Toutes</option>
            <option value="5_critique">5 - Critique</option>
            <option value="4_grave">4 - Grave</option>
            <option value="3_modere">3 - Modéré</option>
            <option value="1_faible">1-2 - Faible</option>
          </select>
        </div>
        <div class="md:col-span-3 flex items-end">
          <button id="reset-btn" class="w-full px-4 py-2.5 text-sm font-display font-semibold rounded-lg border border-ibi-border text-ibi-fg2 hover:bg-ibi-arctic transition-colors">&#x21BA; Réinitialiser</button>
        </div>
      </div>
      <div class="mt-4 flex items-center justify-between text-sm">
        <div class="text-ibi-fg2">
          <span id="results-count" class="font-display font-semibold text-ibi-primary">{biais.length}</span>
          <span> biais trouvés</span>
        </div>
      </div>
    </div>
  </section>

  <!-- GRILLE DE BIAIS -->
  <section class="bg-ibi-arctic py-12 min-h-[600px]">
    <div class="max-w-7xl mx-auto px-6">
      <div id="results-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {biais.map((b) => {
          const sevMap = { "5_critique": "bg-red-100 text-red-800 border-red-200", "4_grave": "bg-amber-100 text-amber-800 border-amber-200", "3_modere": "bg-yellow-100 text-yellow-800 border-yellow-200", "1_faible": "bg-green-100 text-green-800 border-green-200" };
          const sevColor = sevMap[b.severite] || "bg-gray-100 text-gray-700 border-gray-200";
          return (
            <a href={`/fr/biais/${b.ibi_id}`}
               class="biais-card group bg-white rounded-xl border border-ibi-border p-6 hover:border-ibi-primary hover:shadow-lg transition-all"
               data-id={b.ibi_id}
               data-nom={(b.nom_fr || "").toLowerCase()}
               data-score={b.score_ibi || 0}
               data-axe-o={b.axe_o || ""}
               data-axe-l={b.axe_l || ""}
               data-severite={b.severite || ""}>
              <div class="flex items-start justify-between gap-3 mb-3">
                <span class="font-display font-mono text-xs px-2 py-1 rounded bg-ibi-arctic text-ibi-primary">{b.ibi_id}</span>
                <span class="text-xs font-display font-bold text-gradient-ibi">{b.score_ibi ? Number(b.score_ibi).toFixed(1) : "-"}</span>
              </div>
              <h3 class="font-display font-semibold text-base mb-2 group-hover:text-ibi-primary transition-colors leading-snug">{b.nom_fr}</h3>
              <p class="text-xs text-ibi-fg3 italic mb-3">{b.nom_en}</p>
              <p class="text-sm text-ibi-fg2 leading-relaxed mb-4">{b.definition_fr ? b.definition_fr.substring(0, 120) + "..." : ""}</p>
              <div class="flex flex-wrap gap-1.5 mb-3">
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-ibi-arctic text-ibi-fg2">{b.axe_o || ""}</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-ibi-arctic text-ibi-fg2">{b.axe_l || ""}</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-ibi-arctic text-ibi-fg2">{b.axe_s || ""}</span>
              </div>
              <span class={`inline-block text-[10px] font-display font-semibold px-2 py-1 rounded border ${sevColor}`}>{b.severite || "-"}</span>
            </a>
          );
        })}
      </div>

      <div id="empty-state" class="hidden text-center py-20">
        <div class="text-4xl md:text-6xl mb-4">&#x1F50D;</div>
        <h3 class="font-display font-semibold text-xl mb-2">Aucun biais trouvé</h3>
        <p class="text-ibi-fg2">Essayez d'autres critères de recherche.</p>
      </div>

      <!-- Pagination -->
      <div id="pagination" class="mt-12 flex items-center justify-center gap-2">
        <button id="prev-btn" class="px-4 py-2 text-sm font-display font-semibold rounded-lg border border-ibi-border bg-white text-ibi-fg2 hover:bg-ibi-arctic disabled:opacity-40 disabled:cursor-not-allowed">&larr; Précédent</button>
        <div id="page-info" class="px-4 py-2 text-sm text-ibi-fg2">Page 1</div>
        <button id="next-btn" class="px-4 py-2 text-sm font-display font-semibold rounded-lg border border-ibi-border bg-white text-ibi-fg2 hover:bg-ibi-arctic disabled:opacity-40 disabled:cursor-not-allowed">Suivant &rarr;</button>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="gradient-ibi rounded-2xl p-12 text-center text-white">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">Contribuer à la base</h2>
      <p class="text-white/90 max-w-2xl mx-auto mb-8">Un biais manque? Une source à ajouter? Cette base est ouverte et évolutive. Contribuez via l'API ou par email.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <ContributionModal />
      </div>
    </div>
  </section>

  <!-- SCRIPT CLIENT-SIDE (Filtrage DOM) -->
  <script>
    (function() {
      let state = { search: "", sort: "score-desc", limit: 24, offset: 0, axeO: "", axeL: "", severite: "" };

      const $ = (id) => document.getElementById(id);
      const searchInput = $("search-input");
      const sortSelect = $("sort-select");
      const limitSelect = $("limit-select");
      const filterO = $("filter-o");
      const filterL = $("filter-l");
      const filterSev = $("filter-sev");
      const resetBtn = $("reset-btn");
      const grid = $("results-grid");
      const emptyState = $("empty-state");
      const pagination = $("pagination");
      const prevBtn = $("prev-btn");
      const nextBtn = $("next-btn");
      const pageInfo = $("page-info");
      const resultsCount = $("results-count");

      // On récupère toutes les cartes déjà générées par Astro
      const allCards = Array.from(document.querySelectorAll(".biais-card"));

      function applyFilters() {
        let filtered = allCards.filter(card => {
          const matchSearch = !state.search || card.getAttribute("data-nom").includes(state.search.toLowerCase()) || card.getAttribute("data-id").toLowerCase().includes(state.search.toLowerCase());
          const matchO = !state.axeO || card.getAttribute("data-axe-o") === state.axeO;
          const matchL = !state.axeL || card.getAttribute("data-axe-l") === state.axeL;
          const matchSev = !state.severite || card.getAttribute("data-severite") === state.severite;
          return matchSearch && matchO && matchL && matchSev;
        });

        // Tri
        filtered.sort((a, b) => {
          if (state.sort === "score-desc") return parseFloat(b.getAttribute("data-score")) - parseFloat(a.getAttribute("data-score"));
          if (state.sort === "score-asc") return parseFloat(a.getAttribute("data-score")) - parseFloat(b.getAttribute("data-score"));
          if (state.sort === "id-asc") return a.getAttribute("data-id").localeCompare(b.getAttribute("data-id"));
          if (state.sort === "nom-asc") return a.getAttribute("data-nom").localeCompare(b.getAttribute("data-nom"));
          return 0;
        });

        const total = filtered.length;
        resultsCount.textContent = total;
        
        // Pagination
        const start = state.offset;
        const end = start + state.limit;
        const pageItems = filtered.slice(start, end);

        // Cacher toutes les cartes, puis montrer celles de la page
        allCards.forEach(c => c.classList.add("hidden"));
        pageItems.forEach(c => c.classList.remove("hidden"));

        emptyState.classList.toggle("hidden", total > 0);
        pagination.classList.toggle("hidden", total === 0);

        const currentPage = Math.floor(state.offset / state.limit) + 1;
        const totalPages = Math.max(1, Math.ceil(total / state.limit));
        pageInfo.textContent = "Page " + currentPage + " / " + totalPages;
        
        prevBtn.disabled = state.offset === 0;
        nextBtn.disabled = end >= total;
      }

      let searchTimer;
      searchInput.addEventListener("input", () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => { state.search = searchInput.value.trim(); state.offset = 0; applyFilters(); }, 300);
      });
      
      sortSelect.addEventListener("change", () => { state.sort = sortSelect.value; state.offset = 0; applyFilters(); });
      limitSelect.addEventListener("change", () => { state.limit = parseInt(limitSelect.value); state.offset = 0; applyFilters(); });
      filterO.addEventListener("change", () => { state.axeO = filterO.value; state.offset = 0; applyFilters(); });
      filterL.addEventListener("change", () => { state.axeL = filterL.value; state.offset = 0; applyFilters(); });
      filterSev.addEventListener("change", () => { state.severite = filterSev.value; state.offset = 0; applyFilters(); });

      resetBtn.addEventListener("click", () => {
        searchInput.value = ""; sortSelect.value = "score-desc"; limitSelect.value = "24";
        filterO.value = ""; filterL.value = ""; filterSev.value = "";
        state = { search: "", sort: "score-desc", limit: 24, offset: 0, axeO: "", axeL: "", severite: "" };
        applyFilters();
      });

      prevBtn.addEventListener("click", () => { state.offset = Math.max(0, state.offset - state.limit); applyFilters(); window.scrollTo({ top: 0, behavior: "smooth" }); });
      nextBtn.addEventListener("click", () => { state.offset += state.limit; applyFilters(); window.scrollTo({ top: 0, behavior: "smooth" }); });

      // Initialisation
      applyFilters();
    })();
  </script>
</BaseLayout>