import BaseLayout from "../../../layouts/BaseLayout.astro";

// Indispensable pour dire ÃƒÂ  Astro de gÃƒÂ©nÃƒÂ©rer les pages au build malgrÃƒÂ© output: 'server'
export const prerender = true;

export async function getStaticPaths() {
  try {
    const res = await fetch("https://api.ai-biais-initiative.org/biais?select=*,axe_o:axe_o_id(*),axe_l:axe_l_id(*),axe_s:axe_s_id(*),biais_sources(sources(*)),biais_reglementations(reglementations(*)),biais_secteurs(secteurs(*)),biais_methodologies(methodologies(*)),biais_groupes(groupes_impactes(*)),incidents_biais(incidents(*))");
    if (!res.ok) return [];
    const biais = await res.json();
    return biais.map((b) => ({
      params: { ibi_id: b.ibi_id },
      props: { b },
    }));
  } catch (err) {
    return [];
  }
}

const { b } = Astro.props;

// Gestion de la sÃƒÂ©vÃƒÂ©ritÃƒÂ©
const sevMap = {
  "5_critique": { label: "5 - Critique", color: "bg-red-100 text-red-800 border-red-300" },
  "4_grave": { label: "4 - Grave", color: "bg-amber-100 text-amber-800 border-amber-300" },
  "3_modere": { label: "3 - ModÃƒÂ©rÃƒÂ©", color: "bg-yellow-100 text-yellow-800 border-yellow-300" },
  "1_faible": { label: "1-2 - Faible", color: "bg-green-100 text-green-800 border-green-300" }
};
const sev = sevMap[b.severite] || { label: b.severite || "-", color: "bg-gray-100 text-gray-700 border-gray-300" };

const formatDate = (iso) => {
  if (!iso) return "-";
  try { return new Date(iso).toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" }); }
  catch (e) { return iso; }
};

// Groupement des rÃƒÂ©glementations
const regs = (b.biais_reglementations || []).map(br => br.reglementations).filter(Boolean);
const groupedRegs = regs.reduce((acc, reg) => {
  let jur = reg.juridiction || "International";
  if (jur === "UE") jur = "Ã°Å¸â€¡ÂªÃ°Å¸â€¡Âº Europe";
  else if (jur === "USA") jur = "Ã°Å¸â€¡ÂºÃ°Å¸â€¡Â¸ Ãƒâ€°tats-Unis";
  else if (jur === "France") jur = "Ã°Å¸â€¡Â«Ã°Å¸â€¡Â· France";
  else if (jur === "ONU" || jur === "ISO") jur = "Ã°Å¸Å’Â International";
  else jur = "Ã°Å¸Å’Â " + jur;
  if (!acc[jur]) acc[jur] = [];
  acc[jur].push(reg);
  return acc;
}, {});
