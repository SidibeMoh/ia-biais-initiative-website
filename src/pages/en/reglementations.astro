---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

const res = await fetch("https://api.ai-biais-initiative.org/v_api_regulations?select=*&order=code.asc&limit=100");
const regs = await res.json();
---

<BaseLayout title="Global AI Regulations | AI BIAIS" description="Discover 68 global regulatory frameworks governing Artificial Intelligence (EU AI Act, GDPR, NIST AI RMF, etc.).">
  <section class="relative overflow-hidden bg-ibi-night text-white">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full blur-3xl opacity-20" style="background: radial-gradient(circle, #6B1EE8 0%, transparent 70%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-6 py-20 md:py-28">
      <div class="max-w-3xl">
        <p class="text-xs font-display font-semibold tracking-[0.14em] uppercase text-ibi-primary mb-6">Repository · 68 regulations</p>
        <h1 class="font-display font-extrabold text-4xl md:text-6xl leading-tight mb-6">
          Global <span class="text-gradient-ibi">regulations</span> for AI
        </h1>
        <p class="text-lg md:text-xl text-ibi-fg3 leading-relaxed">
          EU AI Act, UNESCO, OECD, GDPR, NIST AI RMF and 63 other global regulatory frameworks. Filter by jurisdiction, obligation type, and view applicable sanctions.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white border-b border-ibi-border sticky top-16 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 py-6">
      <div class="flex flex-wrap items-end gap-3">
        <div class="flex-1 min-w-[240px]">
          <label class="block text-xs font-display font-semibold text-ibi-fg2 mb-1.5">&#x1F50D; Search</label>
          <input id="search-input" type="text" placeholder="Ex: AI Act, GDPR, transparency..."
            class="w-full px-4 py-2.5 text-sm rounded-lg border border-ibi-border bg-white focus:border-ibi-primary focus:outline-none focus:ring-2 focus:ring-ibi-primary/20 transition-all" />
        </div>
        <div class="w-44">
          <label class="block text-xs font-display font-semibold text-ibi-fg2 mb-1.5">&#x2696; Jurisdiction</label>
          <select id="filter-juridiction" class="w-full px-3 py-2.5 text-sm rounded-lg border border-ibi-border bg-white focus:border-ibi-primary focus:outline-none">
            <option value="">All</option>
          </select>
        </div>
        <div class="w-40">
          <label class="block text-xs font-display font-semibold text-ibi-fg2 mb-1.5">&#x1F4CB; Type</label>
          <select id="filter-type" class="w-full px-3 py-2.5 text-sm rounded-lg border border-ibi-border bg-white focus:border-ibi-primary focus:outline-none">
            <option value="">All</option>
          </select>
        </div>
        <button id="reset-btn" class="px-3 py-2.5 text-sm font-display font-semibold rounded-lg border border-ibi-border text-ibi-fg2 hover:bg-ibi-arctic transition-colors" title="Reset">&#x21BA;</button>
      </div>
      <div class="mt-4 flex items-center justify-between text-sm">
        <div class="text-ibi-fg2">
          <span id="results-count" class="font-display font-semibold text-ibi-primary">{regs.length}</span>
          <span> regulations found</span>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ibi-arctic py-12 min-h-[600px]">
    <div class="max-w-7xl mx-auto px-6">
      <div id="results-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {regs.map((r) => (
          <div class="reg-card bg-white rounded-xl border border-ibi-border p-6 hover:border-ibi-primary hover:shadow-lg transition-all" 
               data-juridiction={r.juridiction || ""} 
               data-type={r.type_obligation || ""} 
               data-search={`${r.texte || ""} ${r.code || ""} ${r.obligation || ""}`.toLowerCase()}>
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <span class="font-display font-mono text-xs px-2 py-1 rounded bg-ibi-primary/10 text-ibi-primary font-semibold">{r.code || ""}</span>
              <span class="text-xs font-display font-medium px-2 py-1 rounded bg-ibi-arctic text-ibi-fg2">{r.juridiction || "-"}</span>
              {r.type_obligation && <span class="text-xs font-display font-medium px-2 py-1 rounded bg-violet-100 text-violet-800">{r.type_obligation}</span>}
            </div>
            <h3 class="font-display font-bold text-lg mb-2 leading-snug">{r.texte || "-"}</h3>
            {r.article && <p class="text-sm text-ibi-fg2 mb-3"><strong class="text-ibi-fg">{r.article}</strong></p>}
            <p class="text-sm text-ibi-fg2 leading-relaxed mb-4">{r.obligation || ""}</p>
            {r.deadline && <div class="text-xs text-ibi-fg3 mb-2"><strong class="text-ibi-fg2">Deadline:</strong> {r.deadline}</div>}
            {r.sanction && <div class="text-xs text-red-700 mt-2 p-2 bg-red-50 rounded border border-red-100"><strong>&#x26A0; Sanction:</strong> {r.sanction}</div>}
          </div>
        ))}
      </div>
      <div id="empty-state" class="hidden text-center py-20">
        <div class="text-4xl md:text-6xl mb-4">&#x1F50D;</div>
        <h3 class="font-display font-semibold text-xl mb-2">No regulations found</h3>
        <p class="text-ibi-fg2">Try different search criteria.</p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="gradient-ibi rounded-2xl p-12 text-center text-white">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">Compliance and Governance</h2>
      <p class="text-white/90 max-w-2xl mx-auto mb-8">
        Regulations are evolving. This database is continuously updated to reflect the state of global AI law.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/en/aexia" class="inline-flex items-center gap-2 px-6 py-3 font-display font-semibold rounded-lg bg-white text-ibi-primary hover:bg-white/95">AEXIA Framework</a>
      </div>
    </div>
  </section>

  <script>
    (function() {
      const searchInput = document.getElementById("search-input");
      const filterJuridiction = document.getElementById("filter-juridiction");
      const filterType = document.getElementById("filter-type");
      const resetBtn = document.getElementById("reset-btn");
      const resultsCount = document.getElementById("results-count");
      const emptyState = document.getElementById("empty-state");
      const cards = Array.from(document.querySelectorAll(".reg-card"));

      const jurisdictions = [...new Set(cards.map(c => c.getAttribute("data-juridiction")).filter(Boolean))].sort();
      const types = [...new Set(cards.map(c => c.getAttribute("data-type")).filter(Boolean))].sort();

      jurisdictions.forEach(j => {
        const opt = document.createElement("option");
        opt.value = j; opt.textContent = j;
        filterJuridiction.appendChild(opt);
      });
      types.forEach(t => {
        const opt = document.createElement("option");
        opt.value = t; opt.textContent = t;
        filterType.appendChild(opt);
      });

      function filterCards() {
        const q = searchInput.value.toLowerCase().trim();
        const jur = filterJuridiction.value;
        const typ = filterType.value;
        let visibleCount = 0;

        cards.forEach(card => {
          const matchSearch = !q || card.getAttribute("data-search").includes(q);
          const matchJur = !jur || card.getAttribute("data-juridiction") === jur;
          const matchTyp = !typ || card.getAttribute("data-type") === typ;

          if (matchSearch && matchJur && matchTyp) {
            card.classList.remove("hidden");
            visibleCount++;
          } else {
            card.classList.add("hidden");
          }
        });

        resultsCount.textContent = visibleCount;
        if (visibleCount === 0) {
          emptyState.classList.remove("hidden");
        } else {
          emptyState.classList.add("hidden");
        }
      }

      let timer;
      searchInput.addEventListener("input", () => {
        clearTimeout(timer);
        timer = setTimeout(filterCards, 300);
      });
      filterJuridiction.addEventListener("change", filterCards);
      filterType.addEventListener("change", filterCards);
      
      resetBtn.addEventListener("click", () => {
        searchInput.value = "";
        filterJuridiction.value = "";
        filterType.value = "";
        filterCards();
      });
    })();
  </script>
  
  <script>
    window.addEventListener('load', () => {
        setTimeout(() => {
            const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
            let node;
            while (node = walker.nextNode()) {
                if (node.nodeValue.includes('—') || node.nodeValue.includes('–')) {
                    node.nodeValue = node.nodeValue.replace(/—/g, ' : ').replace(/–/g, ' : ');
                }
            }
        }, 500);
    });
  </script>
</BaseLayout>