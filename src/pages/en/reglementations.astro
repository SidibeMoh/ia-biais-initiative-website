<script is:inline>
const dict = {
  "Émirats Arabes Unis : Charte IA": "United Arab Emirates: AI Charter",
  "Les EAU visent à relever les défis du biais algorithmique.": "The UAE aims to address the challenges of algorithmic bias.",
  "Droit de ne pas être soumis à une décision automatisée sans garanties.": "Right not to be subject to an automated decision without guarantees.",
  "Les données d'entraînement des systèmes IA à haut risque doivent être examinées pour les biais potentiels.": "Training data for high-risk AI systems must be examined for potential biases.",
  "Les systèmes IA à haut risque doivent permettre leur interprétation.": "High-risk AI systems must allow for their interpretation.",
  "Les systèmes IA à haut risque doivent permettre une supervision humaine effective.": "High-risk AI systems must allow for effective human oversight.",
  "Les systèmes IA à haut risque doivent atteindre des niveaux appropriés de précision et de cybersécurité.": "High-risk AI systems must achieve appropriate levels of accuracy and cybersecurity.",
  "Les déployeurs doivent utiliser les systèmes à haut risque conformément aux instructions et surveiller leur fonctionnement.": "Deployers must use high-risk systems in accordance with instructions and monitor their operation.",
  "Les déployeurs doivent réaliser une analyse d'impact sur les droits fondamentaux avant la mise en service.": "Deployers must carry out a fundamental rights impact assessment before putting the system into service.",
  "Interdiction des systèmes IA utilisant des techniques subliminales, exploitant les vulnérabilités, ou pratiquant le social scoring.": "Prohibition of AI systems using subliminal techniques, exploiting vulnerabilities, or practicing social scoring.",
  "Définition des systèmes à haut risque par référence à l'Annexe III.": "Definition of high-risk systems by reference to Annex III.",
  "Les fournisseurs doivent établir un système de surveillance après mise sur le marché.": "Providers must establish a post-market monitoring system.",
  "Un système de gestion des risques doit être mis en place.": "A risk management system must be established.",
  "Liste des cas d'usage à haut risque : biométrie, infrastructures critiques, éducation, emploi, justice, migration.": "List of high-risk use cases: biometrics, critical infrastructure, education, employment, justice, migration.",
  "Argentine : Résolution AAIP sur l'IA": "Argentina: AAIP Resolution on AI",
  "Exigences de transparence pour les systèmes d'IA traitant des données argentines.": "Transparency requirements for AI systems processing Argentine data.",
  "Principe d'équité et de non-discrimination dans les systèmes d'IA australiens.": "Principle of fairness and non-discrimination in Australian AI systems.",
  "Union Africaine : Stratégie Continentale IA": "African Union: Continental AI Strategy",
  "Feuille de route 2025-2030 pour l'innovation et la gouvernance.": "2025-2030 roadmap for innovation and governance.",
  "Brésil : LGPD": "Brazil: LGPD",
  "Droit à la révision des décisions automatisées.": "Right to review automated decisions.",
  "Brésil : Projet de loi IA (PL 2338/2023)": "Brazil: AI Bill (PL 2338/2023)",
  "Centralité de la personne humaine, respect des droits humains et des valeurs démocratiques.": "Centrality of the human person, respect for human rights and democratic values.",
  "Canada : Loi sur l'IA et les données (AIDA)": "Canada: AI and Data Act (AIDA)",
  "Cadre basé sur les risques pour les systèmes d'IA à impact élevé.": "Risk-based framework for high-impact AI systems.",
  "Canada : Directive sur la prise de décision automatisée": "Canada: Directive on Automated Decision-Making",
  "Les institutions fédérales doivent publier un avis de décision automatisée.": "Federal institutions must publish an automated decision notice."
};

function translateTree() {
  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
  let node;
  while (node = walker.nextNode()) {
    let text = node.nodeValue.trim();
    if (dict[text]) {
      node.nodeValue = node.nodeValue.replace(text, dict[text]);
    }
  }
}
setInterval(translateTree, 500);
</script>