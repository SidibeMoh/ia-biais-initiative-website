---
import BaseLayout from "../../layouts/BaseLayout.astro";

const typesRapports = [
  {
    icon: "📈",
    titre: "Monthly Barometer",
    frequence: "Mensuel",
    format: "2-3 pages",
    desc: "Quick and visual synthesis of algorithmic bias news. Top 10 emerging biases, notable incidents, regulatory changes.",
    public: "Press, LinkedIn, decision-makers",
    color: "#2D46F5"
  },
  {
    icon: "📊",
    titre: "Sector Report",
    frequence: "Trimestriel",
    format: "20-25 pages",
    desc: "In-depth analysis of sector-specific biases. Case study, risk mapping, operational recommendations, and AI Act obligations.",
    public: "Companies, consulting firms",
    color: "#6B1EE8"
  },
  {
    icon: "📚",
    titre: "Annual Report",
    frequence: "Annuel",
    format: "50-80 pages",
    desc: "Complete inventory of AI biases over the studied year. Longitudinal analysis, guest expert contributions, projections, and strategic recommendations.",
    public: "Institutions, academia, NGOs",
    color: "#1A2BCC"
  }
];

const bibtexExemple = `@techreport{aibiais2026barometre1,
  author      = {AI BIAIS INITIATIVE},
  title       = {Barometer #1 - Top 10 AI biases in 2026},
  institution = {AI BIAIS INITIATIVE},
  year        = 2026,
  month       = nov,
  type        = {Scientific report},
  doi         = {10.5281/zenodo.XXXXXXX},
  url         = {https://ai-biais-initiative.org/rapports}
}`;
---

<BaseLayout
  title="Rapports & analyses - AI BIAIS INITIATIVE"
  description="Rapports périodiques sur les biais algorithmiques : baromètres mensuels, analyses sectorielles et Annual Report."
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-ibi-night text-white">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full blur-3xl opacity-20" style="background: radial-gradient(circle, #2D46F5 0%, transparent 70%)"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full blur-3xl opacity-15" style="background: radial-gradient(circle, #6B1EE8 0%, transparent 70%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32">
      <div class="max-w-3xl">
        <p class="text-xs font-display font-semibold tracking-[0.14em] uppercase text-ibi-primary mb-6">
          PUBLICATIONS · PERIODIC ANALYSES
        </p>
        <h1 class="font-display font-extrabold text-4xl md:text-6xl leading-tight mb-6">
          Scientific <span class="text-gradient-ibi">Reports</span>
        </h1>
        <p class="text-lg md:text-xl text-ibi-fg3 leading-relaxed mb-8">
          Regular analyses on algorithmic biases, designed for the scientific community, businesses, institutions, and public policymakers. Citable via Zenodo DOI.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#types" class="inline-flex items-center gap-2 px-6 py-3 font-display font-semibold rounded-lg gradient-ibi text-white hover:opacity-90 transition-opacity">
            Discover the reports
            <span aria-hidden="true">↓</span>
          </a>
          <a href="mailto:contact@ai-biais-initiative.org?subject=Information%20Rapports" class="inline-flex items-center gap-2 px-6 py-3 font-display font-semibold rounded-lg border border-ibi-border text-white hover:bg-white/5 transition-colors">
            Contact us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- A VENIR -->
  <section class="max-w-7xl mx-auto px-6 -mt-12 relative z-10">
    <div class="bg-gradient-to-r from-amber-50 to-orange-50 rounded-2xl border-2 border-amber-200 p-8 md:p-10">
      <div class="flex items-start gap-4">
        <div class="text-4xl shrink-0">🚀</div>
        <div class="flex-1">
          <h2 class="font-display font-bold text-2xl md:text-3xl mb-3 text-amber-900">
            The first reports are coming soon
          </h2>
          <p class="text-amber-800 leading-relaxed mb-4">
            The knowledge base is live. The first scientific reports will be published progressively starting November 2026. Each report will be:
          </p>
          <ul class="grid md:grid-cols-2 gap-2 text-sm text-amber-800">
            <li class="flex items-center gap-2"><span class="text-amber-600 font-bold">✓</span> Free download in PDF</li>
            <li class="flex items-center gap-2"><span class="text-amber-600 font-bold">✓</span> Citable via a dedicated Zenodo DOI</li>
            <li class="flex items-center gap-2"><span class="text-amber-600 font-bold">✓</span> Under open license CC-BY 4.0</li>
            <li class="flex items-center gap-2"><span class="text-amber-600 font-bold">✓</span> Based on the 250 documented biases</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- TYPES DE RAPPORTS -->
  <section id="types" class="max-w-7xl mx-auto px-6 py-24">
    <div class="max-w-3xl mb-12">
      <p class="text-xs font-display font-semibold tracking-[0.14em] uppercase text-ibi-primary mb-3">THREE FORMATS</p>
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">A complete range of publications</h2>
      <p class="text-ibi-fg2 leading-relaxed">
        Three levels of depth to meet the needs of all audiences: quick monitoring, in-depth sector analysis, and reference annual synthesis.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {typesRapports.map((r) => (
        <div class="bg-white rounded-2xl border border-ibi-border p-8 hover:shadow-lg hover:border-ibi-primary transition-all">
          <div class="text-3xl md:text-5xl mb-5">{r.icon}</div>
          <h3 class="font-display font-bold text-xl mb-2">{r.titre}</h3>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-xs font-display font-semibold px-2 py-1 rounded" style={`background: ${r.color}20; color: ${r.color}`}>
              {r.frequence}
            </span>
            <span class="text-xs font-display font-medium px-2 py-1 rounded bg-ibi-arctic text-ibi-fg2">
              {r.format}
            </span>
          </div>
          <p class="text-sm text-ibi-fg2 leading-relaxed mb-5">{r.desc}</p>
          <div class="pt-4 border-t border-ibi-border">
            <div class="text-xs text-ibi-fg3 uppercase tracking-wider mb-1">TARGET AUDIENCE</div>
            <div class="text-sm text-ibi-fg font-medium">{r.public}</div>
          </div>
        </div>
      ))}
    </div>
  </section>
  <!-- PROCHAINS RAPPORTS -->
  <section class="bg-ibi-arctic py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-12">
        <p class="text-xs font-display font-semibold tracking-[0.14em] uppercase text-ibi-primary mb-3">Roadmap</p>
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">Publication Calendar</h2><p><strong>IBI INDEX 2026</strong> : global state of AI biases Coming soon in December 2026.</p>
        <p class="text-ibi-fg2 leading-relaxed">
          Here is the indicative calendar of upcoming reports. Each publication will be accompanied by a Zenodo DOI and a press release.
        </p>
      </div>

      <div class="space-y-4">
        <!-- Novembre 2026 -->
        <div class="bg-white rounded-2xl border border-ibi-border p-6 md:p-8 hover:shadow-lg transition-all">
          <div class="flex flex-wrap items-start gap-6">
            <div class="w-20 h-20 rounded-xl gradient-ibi flex flex-col items-center justify-center text-white shrink-0">
              <div class="text-xs font-display font-semibold">NOV</div>
              <div class="text-2xl font-display font-bold">2026</div>
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="text-xs font-display font-bold px-2 py-1 rounded bg-blue-100 text-blue-800">📈 Baromètre</span>
                <span class="text-xs font-display font-semibold px-2 py-1 rounded bg-amber-100 text-amber-800">Coming soon</span>
              </div>
              <h3 class="font-display font-bold text-xl mb-2">Barometer #1 - Top 10 AI biases in 2026</h3>
              <p class="text-sm text-ibi-fg2 leading-relaxed">
                Ranking of the 10 most critical algorithmic biases identified in the database. Analysis of 2026 trends, notable incidents, and regulatory developments.
              </p>
            </div>
          </div>
        </div>

        <!-- Décembre 2026 -->
        <div class="bg-white rounded-2xl border border-ibi-border p-6 md:p-8 hover:shadow-lg transition-all">
          <div class="flex flex-wrap items-start gap-6">
            <div class="w-20 h-20 rounded-xl gradient-ibi flex flex-col items-center justify-center text-white shrink-0">
              <div class="text-xs font-display font-semibold">DÉC</div>
              <div class="text-2xl font-display font-bold">2026</div>
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="text-xs font-display font-bold px-2 py-1 rounded bg-purple-100 text-purple-800">📊 Sector Report</span>
                <span class="text-xs font-display font-semibold px-2 py-1 rounded bg-amber-100 text-amber-800">Coming soon</span>
              </div>
              <h3 class="font-display font-bold text-xl mb-2">Finance Report 2026 - Algorithmic biases in financial services</h3>
              <p class="text-sm text-ibi-fg2 leading-relaxed">
                In-depth analysis of biases in credit scoring, fraud detection, and asset management. Risk mapping, AI Act obligations, operational recommendations.
              </p>
            </div>
          </div>
        </div>

        <!-- Janvier 2027 -->
        <div class="bg-white rounded-2xl border border-ibi-border p-6 md:p-8 hover:shadow-lg transition-all">
          <div class="flex flex-wrap items-start gap-6">
            <div class="w-20 h-20 rounded-xl gradient-ibi flex flex-col items-center justify-center text-white shrink-0">
              <div class="text-xs font-display font-semibold">JAN</div>
              <div class="text-2xl font-display font-bold">2027</div>
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="text-xs font-display font-bold px-2 py-1 rounded bg-purple-100 text-purple-800">📊 Sector Report</span>
                <span class="text-xs font-display font-semibold px-2 py-1 rounded bg-amber-100 text-amber-800">Coming soon</span>
              </div>
              <h3 class="font-display font-bold text-xl mb-2">Health Report 2027 - Medical AI and equity of access to care</h3>
              <p class="text-sm text-ibi-fg2 leading-relaxed">
                Biases in diagnostic support systems, telemedicine, and patient prioritization. Ethical issues, documented cases, and European regulatory framework.
              </p>
            </div>
          </div>
        </div>

        <!-- Février 2027 -->
        <div class="bg-white rounded-2xl border border-ibi-border p-6 md:p-8 hover:shadow-lg transition-all">
          <div class="flex flex-wrap items-start gap-6">
            <div class="w-20 h-20 rounded-xl gradient-ibi flex flex-col items-center justify-center text-white shrink-0">
              <div class="text-xs font-display font-semibold">FÉV</div>
              <div class="text-2xl font-display font-bold">2027</div>
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="text-xs font-display font-bold px-2 py-1 rounded bg-purple-100 text-purple-800">📊 Sector Report</span>
                <span class="text-xs font-display font-semibold px-2 py-1 rounded bg-amber-100 text-amber-800">Coming soon</span>
              </div>
              <h3 class="font-display font-bold text-xl mb-2">HR Report 2027 - Biases in algorithmic recruitment</h3>
              <p class="text-sm text-ibi-fg2 leading-relaxed">
                Selection bias, discriminatory proxies, and amplification of stereotypes in CV sorting tools. Compliance with the European directive on equal treatment.
              </p>
            </div>
          </div>
        </div>

        <!-- Annual Report -->
        <div class="bg-gradient-to-r from-ibi-night to-ibi-marine rounded-2xl border border-ibi-primary/30 p-6 md:p-8 text-white">
          <div class="flex flex-wrap items-start gap-6">
            <div class="w-20 h-20 rounded-xl bg-white/10 backdrop-blur flex flex-col items-center justify-center shrink-0">
              <div class="text-xs font-display font-semibold text-ibi-fg3">ÉTÉ</div>
              <div class="text-2xl font-display font-bold">2027</div>
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="text-xs font-display font-bold px-2 py-1 rounded bg-ibi-primary/30 text-white">📚 Annual Report</span>
                <span class="text-xs font-display font-semibold px-2 py-1 rounded bg-white/10 text-ibi-fg3">2027 Edition</span>
              </div>
              <h3 class="font-display font-bold text-xl mb-2">IBI INDEX 2027 - Global state of AI biases</h3>
              <p class="text-sm text-ibi-fg3 leading-relaxed">
                Reference report bringing together all analyses of the year. Guest expert contributions, 2028-2030 projections, recommendations for public policymakers and international institutions.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMMENT CITER -->
  <section class="bg-ibi-night text-white py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <p class="text-xs font-display font-semibold tracking-[0.14em] uppercase text-ibi-primary mb-3">ACADEMIC CITATION</p>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6">How to cite our reports</h2>
          <p class="text-ibi-fg3 leading-relaxed mb-6">
            Each published report will receive a <strong class="text-white">DOI Zenodo</strong>, allowing researchers, academics, and institutions to cite it in a standardized way in their work.
          </p>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-ibi-primary/20 flex items-center justify-center text-ibi-primary font-bold text-sm shrink-0">1</div>
              <div>
                <div class="font-display font-semibold mb-1">The DOI is assigned automatically</div>
                <div class="text-sm text-ibi-fg3">Upon publication on Zenodo</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-ibi-primary/20 flex items-center justify-center text-ibi-primary font-bold text-sm shrink-0">2</div>
              <div>
                <div class="font-display font-semibold mb-1">A BibTeX format is provided</div>
                <div class="text-sm text-ibi-fg3">Copy-paste directly into LaTeX, Word, or Zotero</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-ibi-primary/20 flex items-center justify-center text-ibi-primary font-bold text-sm shrink-0">3</div>
              <div>
                <div class="font-display font-semibold mb-1">Reports are CC-BY 4.0</div>
                <div class="text-sm text-ibi-fg3">Freely reusable with attribution</div>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-ibi-marine rounded-2xl border border-ibi-border p-8">
          <div class="text-xs font-display font-semibold tracking-wider uppercase text-ibi-primary mb-4">CITATION EXAMPLE</div>
                    <pre class="bg-black/40 rounded-lg p-5 text-xs font-mono text-ibi-fg3 overflow-x-auto leading-relaxed">{bibtexExemple}</pre>
          <div class="mt-6 text-sm text-ibi-fg3 leading-relaxed">
            <strong class="text-white">NB:</strong> le DOI exact will be assigned upon publication. In the meantime, you can cite the API:
            <div class="mt-2 font-mono text-xs text-ibi-primary">10.5281/zenodo.23400341</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="max-w-7xl mx-auto px-6 py-24">
    <div class="bg-white rounded-2xl border border-ibi-border p-8 md:p-12">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="text-xs font-display font-semibold tracking-[0.14em] uppercase text-ibi-primary mb-3">STAY INFORMED</p>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">Be alerted for each publication</h2>
          <p class="text-ibi-fg2 leading-relaxed mb-6">
            To be notified upon the release of a new report, write to us at the address below. You will receive an email for each publication.
          </p>
          <a href="mailto:contact@ai-biais-initiative.org?subject=Alerte%20Rapports%20-%20Inscription" class="inline-flex items-center gap-2 px-6 py-3 font-display font-semibold rounded-lg gradient-ibi text-white hover:opacity-90">
            <span>📧</span>
            Subscribe to alerts
          </a>
        </div>
        <div class="bg-ibi-arctic rounded-xl p-6 border border-ibi-border">
          <div class="text-xs font-display font-semibold tracking-wider uppercase text-ibi-fg3 mb-4">ROADMAP SUMMARY</div>
          <div class="space-y-3 text-sm">
            <div class="flex justify-between items-center py-2 border-b border-ibi-border">
              <span class="text-ibi-fg2">📈 Monthly Barometer</span>
              <span class="font-display font-semibold text-ibi-primary">From Nov 2026</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-ibi-border">
              <span class="text-ibi-fg2">📊 Sector Reports</span>
              <span class="font-display font-semibold text-ibi-primary">1 / quarter</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="text-ibi-fg2">📚 Annual Report</span>
              <span class="font-display font-semibold text-ibi-primary">Summer 2027</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="max-w-7xl mx-auto px-6 pb-24">
    <div class="gradient-ibi rounded-2xl p-12 text-center text-white">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">Contribute to reports</h2>
      <p class="text-white/90 max-w-2xl mx-auto mb-8">
        Are you a researcher, expert, or institution and wish to contribute to a report? We are open to co-publications and guest expert contributions.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="mailto:contact@ai-biais-initiative.org?subject=Contribution%20Rapports" class="inline-flex items-center gap-2 px-6 py-3 font-display font-semibold rounded-lg bg-white text-ibi-primary hover:bg-white/95 transition-colors">
          Propose a contribution
        </a>
        <a href="/biais" class="inline-flex items-center gap-2 px-6 py-3 font-display font-semibold rounded-lg border-2 border-white/30 text-white hover:bg-white/10 transition-colors">
          Explore the database
        </a>
      </div>
    </div>
  </section>
</BaseLayout>