---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Logo from "../../components/Logo.astro";

const bibtex = `@software{sidibe_2026_ia_biais,
  author    = {SIDIBE, Mohamadou},
  title     = {AI BIAIS Initiative - API REST},
  year      = 2026,
  publisher = {Zenodo},
  version   = {1.0.0},
  doi       = {10.5281/zenodo.23400341}
}`;
---

<BaseLayout title="AI BIAIS INITIATIVE - Global Reference for Algorithmic Biases" description="The scientific knowledge base addressing global concerns about AI biases. 250 biases, 68 regulations, open API.">
  <!-- ═══ HERO ═══ -->
  <section class="relative overflow-hidden bg-ibi-night text-white">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full blur-3xl opacity-20" style="background: radial-gradient(circle, #2D46F5 0%, transparent 70%)"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full blur-3xl opacity-15" style="background: radial-gradient(circle, #6B1EE8 0%, transparent 70%)"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32">
      <div class="max-w-3xl">
        <p class="text-xs font-display font-semibold tracking-[0.14em] uppercase text-ibi-primary mb-6">
          GLOBAL CITIZEN INITIATIVE · DOI 10.5281/zenodo.23400341
        </p>
        
        <h1 class="font-display font-extrabold text-4xl md:text-6xl leading-tight mb-6">
          The Global Reference for <span class="text-gradient-ibi">Algorithmic Biases</span>
        </h1>
        
        <p class="text-lg md:text-xl text-ibi-fg3 leading-relaxed mb-8">
          A rigorous scientific knowledge base to address global concerns about AI biases alNGOsside other institutions.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="/biais" class="inline-flex items-center gap-2 px-6 py-3 font-display font-semibold rounded-lg gradient-ibi text-white hover:opacity-90 transition-opacity">
            Explore the 250 biases
            <span aria-hidden="true">→</span>
          </a>
          <a href="/api" class="inline-flex items-center gap-2 px-6 py-3 font-display font-semibold rounded-lg border border-ibi-border text-white hover:bg-white/5 transition-colors">
            API Documentation
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CHIFFRES CLES ═══ -->
  <section class="max-w-7xl mx-auto px-6 -mt-12 relative z-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border border-ibi-border p-6 text-center">
        <div class="font-display font-extrabold text-4xl text-gradient-ibi mb-2">250</div>
        <div class="text-sm text-ibi-fg2 font-medium">Documented biases</div>
      </div>
      <div class="bg-white rounded-xl border border-ibi-border p-6 text-center">
        <div class="font-display font-extrabold text-4xl text-gradient-ibi mb-2">68</div>
        <div class="text-sm text-ibi-fg2 font-medium">Regulations</div>
      </div>
      <div class="bg-white rounded-xl border border-ibi-border p-6 text-center">
        <div class="font-display font-extrabold text-4xl text-gradient-ibi mb-2">21</div>
        <div class="text-sm text-ibi-fg2 font-medium">Analytical views</div>
      </div>
      <div class="bg-white rounded-xl border border-ibi-border p-6 text-center">
        <div class="font-display font-extrabold text-4xl text-gradient-ibi mb-2">17</div>
        <div class="text-sm text-ibi-fg2 font-medium">RPC Functions</div>
      </div>
    </div>
  </section>

  <!-- ═══ MISSION ═══ -->
  <section class="max-w-7xl mx-auto px-6 py-24">
    <div class="grid md:grid-cols-2 gap-16 items-start">
      <div>
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6">
          Addressing global concerns
        </h2>
        <p class="text-ibi-fg2 leading-relaxed mb-4">
          Leaders of major AI laboratories, researchers, the Pope, NGOs, and international institutions have been warning for several years about the dangers of current developments in artificial intelligence.
        </p>
        <p class="text-ibi-fg2 leading-relaxed mb-4">
          This initiative is a citizen response to these warnings: A rigorous scientific knowledge base to address global concerns about AI biases alNGOsside other institutions.
        </p>
        <p class="text-ibi-fg2 leading-relaxed">
          Each bias is classified according to the <strNGOs class="text-ibi-fg">Taxonomy TriAxis</strNGOs> (Origin × Lifecycle × Specific) and linked to applicable Regulations.
        </p>
      </div>
      
      <div class="space-y-4">
        <div class="bg-white rounded-xl border border-ibi-border p-6">
          <div class="flex items-start gap-4">
            <div class="shrink-0 w-10 h-10 rounded-lg gradient-ibi flex items-center justify-center text-white font-display font-bold">O</div>
            <div>
              <h3 class="font-display font-semibold mb-1">Origin Axis</h3>
              <p class="text-sm text-ibi-fg2">Where does the bias come from? Systemic (O1), computational (O2) or human-cognitive (O3).</p>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl border border-ibi-border p-6">
          <div class="flex items-start gap-4">
            <div class="shrink-0 w-10 h-10 rounded-lg gradient-ibi flex items-center justify-center text-white font-display font-bold">L</div>
            <div>
              <h3 class="font-display font-semibold mb-1">Lifecycle Axis</h3>
              <p class="text-sm text-ibi-fg2">At what stage? From L1_historical (collection) to L6_deployment (production).</p>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl border border-ibi-border p-6">
          <div class="flex items-start gap-4">
            <div class="shrink-0 w-10 h-10 rounded-lg gradient-ibi flex items-center justify-center text-white font-display font-bold">S</div>
            <div>
              <h3 class="font-display font-semibold mb-1">Specific Axis</h3>
              <p class="text-sm text-ibi-fg2">Specific nature: proxy, feedback, sampling, annotation... (28 categories).</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ AEXIA ═══ -->
  <section class="bg-ibi-night text-white py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-12">
        <p class="text-xs font-display font-semibold tracking-[0.14em] uppercase text-ibi-primary mb-4">Framework de Governance</p>
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6">AEXIA - Governance de l'Explainable AI</h2>
        <p class="text-ibi-fg3 leading-relaxed mb-6">
          AEXIA (Accountable, Ethical, eXplainable, Interpretable, Auditable AI) is an integrated framework that articulates the methodological dimension of explainability, organizational maturity, and the individual maturity of deployed systems.
        </p>
        <a href="/aexia" class="inline-flex items-center gap-2 px-6 py-3 font-display font-semibold rounded-lg border border-ibi-border text-white hover:bg-white/5 transition-colors">
          Decouvrir AEXIA
          <span aria-hidden="true">→</span>
        </a>
      </div>
      
      <div class="grid md:grid-cols-3 gap-4">
        <div class="bg-ibi-marine rounded-xl border border-ibi-border p-6">
          <div class="text-2xl mb-3">🧭</div>
          <h3 class="font-display font-semibold mb-2">Dual axis</h3>
          <p class="text-sm text-ibi-fg3">AEXIA-O (organization) and AEXIA-S (system), crossed into a decision matrix.</p>
        </div>
        <div class="bg-ibi-marine rounded-xl border border-ibi-border p-6">
          <div class="text-2xl mb-3">🧩</div>
          <h3 class="font-display font-semibold mb-2">DCME, ECS, RAD</h3>
          <p class="text-sm text-ibi-fg3">Three original contributions: multi-scale causal explanation, consistency score, responsibility debt.</p>
        </div>
        <div class="bg-ibi-marine rounded-xl border border-ibi-border p-6">
          <div class="text-2xl mb-3">🛡️</div>
          <h3 class="font-display font-semibold mb-2">4 mecanismes</h3>
          <p class="text-sm text-ibi-fg3">Weakest link, evidentiary gates, AI-specific downgrading, risk proportionality.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CITATION ═══ -->
  <section class="max-w-7xl mx-auto px-6 py-24">
    <div class="bg-white rounded-2xl border border-ibi-border p-8 md:p-12">
      <div class="max-w-3xl">
        <h2 class="font-display font-bold text-2xl md:text-3xl mb-4">Cite this work</h2>
        <p class="text-ibi-fg2 mb-6">
          If you use this API or this data in your scientific work, please cite:
        </p>
        <pre class="bg-ibi-arctic border border-ibi-border rounded-lg p-6 text-xs font-mono overflow-x-auto text-ibi-fg2">{bibtex}</pre>
        <div class="mt-6">
          <a href="https://doi.org/10.5281/zenodo.23400341" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-ibi-primary font-display font-semibold hover:underline">
            View Zenodo page
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CTA FINAL ═══ -->
  <section class="max-w-7xl mx-auto px-6 pb-24">
    <div class="gradient-ibi rounded-2xl p-12 text-center text-white">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">Join the initiative</h2>
      <p class="text-white/90 max-w-2xl mx-auto mb-8">
        Researchers, policymakers, NGOs, institutions - this database is open. Contribute, cite, criticize. Together, let's make AI a fair tool for everyone.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="mailto:contact@ai-biais-initiative.org" class="inline-flex items-center gap-2 px-6 py-3 font-display font-semibold rounded-lg bg-white text-ibi-primary hover:bg-white/95 transition-colors">
          Contact us
        </a>
        
      </div>
    </div>
  </section>
</BaseLayout>
