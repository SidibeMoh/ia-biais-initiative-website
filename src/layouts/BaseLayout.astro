---
import "../styles/global.css";
import Logo from "../components/Logo.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "IA BIAIS INITIATIVE — Le referentiel mondial des biais algorithmiques",
  description = "API REST ouverte documentant 250 biais, 68 reglementations mondiales et 21 vues analytiques pour la gouvernance ethique de l'IA.",
} = Astro.props;

const navLinks = [
  { href: "/", label: "Accueil" },
  { href: "/biais", label: "Biais" },
  { href: "/reglementations", label: "Reglementations" },
  { href: "/methodologie", label: "Methodologie" },
  { href: "/aexia", label: "AEXIA" },
  { href: "/api", label: "API" },
  { href: "/a-propos", label: "A propos" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Mohamadou SIDIBE — IA BIAIS INITIATIVE" />
    <meta name="theme-color" content="#070C24" />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ai-biais-initiative.org" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title}</title>
  </head>
  <body>
    <!-- Skip to content -->
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-ibi-primary focus:text-white focus:rounded">
      Aller au contenu principal
    </a>

    <!-- Header -->
    <header class="sticky top-0 z-40 backdrop-blur-lg bg-ibi-night/80 border-b border-ibi-border">
      <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-8" aria-label="Navigation principale">
        <a href="/" class="flex items-center shrink-0" aria-label="Accueil IA BIAIS INITIATIVE">
          <Logo class="h-12 w-auto" variant="light" />
        </a>
        
        <ul class="hidden md:flex items-center gap-1">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="px-3 py-2 text-sm font-medium text-ibi-fg3 hover:text-white transition-colors rounded-lg hover:bg-white/5"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        
        <a
          href="https://doi.org/10.5281/zenodo.23400341"
          target="_blank"
          rel="noopener"
          class="hidden lg:inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white rounded-lg gradient-ibi hover:opacity-90 transition-opacity"
        >
          <span>DOI</span>
          <span class="text-white/80">10.5281/zenodo.23400341</span>
        </a>
      </nav>
    </header>

    <!-- Main -->
    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-ibi-night text-ibi-fg3 border-t border-ibi-border mt-24">
      <div class="max-w-7xl mx-auto px-6 py-12 grid md:grid-cols-4 gap-8">
        <div class="md:col-span-2">
          <Logo class="h-12 w-auto mb-4" variant="light" showDomain />
          <p class="text-sm leading-relaxed max-w-md">
            Le referentiel mondial des biais algorithmiques. Une initiative citoyenne pour une IA ethique, explicable et responsable.
          </p>
        </div>
        
        <div>
          <h3 class="font-display font-semibold text-white text-sm uppercase tracking-wider mb-4">Explorer</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/biais" class="hover:text-white transition-colors">Les 250 biais</a></li>
            <li><a href="/reglementations" class="hover:text-white transition-colors">68 reglementations</a></li>
            <li><a href="/methodologie" class="hover:text-white transition-colors">Taxonomie TriAxis</a></li>
            <li><a href="/aexia" class="hover:text-white transition-colors">Framework AEXIA</a></li>
          </ul>
        </div>
        
        <div>
          <h3 class="font-display font-semibold text-white text-sm uppercase tracking-wider mb-4">Ressources</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/api" class="hover:text-white transition-colors">Documentation API</a></li>
            <li><a href="https://github.com/SidibeMoh/ia-biais-initiative-api" target="_blank" rel="noopener" class="hover:text-white transition-colors">GitHub</a></li>
            <li><a href="https://doi.org/10.5281/zenodo.23400341" target="_blank" rel="noopener" class="hover:text-white transition-colors">DOI Zenodo</a></li>
            <li><a href="mailto:contact@ai-biais-initiative.org" class="hover:text-white transition-colors">Contact</a></li>
          </ul>
        </div>
      </div>
      
      <div class="border-t border-ibi-border">
        <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs">
          <p>© 2026 Mohamadou SIDIBE — IA BIAIS INITIATIVE. Licence CC-BY 4.0.</p>
          <p>Fait avec rigueur scientifique et citoyenne.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
