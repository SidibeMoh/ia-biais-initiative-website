---
import "../styles/global.css";
import Logo from "../components/Logo.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AI BIAIS INITIATIVE - Le référentiel mondial des biais algorithmiques",
  description = "API REST ouverte documentant 250 biais, 68 réglementations mondiales et 21 vues analytiques pour la gouvernance éthique de l'IA"
} = Astro.props;

// --- LOGIQUE BILINGUE ---
const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith('/en') ? 'en' : 'fr';
const otherLang = currentLang === 'fr' ? 'en' : 'fr';
const otherLangPath = currentPath.replace(`/${currentLang}/`, `/${otherLang}/`) || `/${otherLang}/`;

const getLink = (href) => {
    if (href === '/') return `/${currentLang}/`;
    return `/${currentLang}${href}`;
};

const navLinks = currentLang === 'fr' ? [
  { href: "/", label: "Accueil" },
  { href: "/biais", label: "Biais" },
  { href: "/reglementations", label: "Réglementations" },
  { href: "/methodologie", label: "Méthodologie" },
  { href: "/aexia", label: "AEXIA" },
  { href: "/rapports", label: "Rapports" },
  { href: "/api", label: "API" },
  { href: "/a-propos", label: "À propos" },
] : [
  { href: "/", label: "Home" },
  { href: "/biais", label: "Biases" },
  { href: "/reglementations", label: "Regulations" },
  { href: "/methodologie", label: "Methodology" },
  { href: "/aexia", label: "AEXIA" },
  { href: "/rapports", label: "Reports" },
  { href: "/api", label: "API" },
  { href: "/a-propos", label: "About" },
];
---
<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">
    <header class="bg-slate-900 text-white shadow-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
          
                    <!-- Logo -->
          <div class="flex-shrink-0 flex items-center">
            <a href={getLink("/")} class="flex items-center gap-3">
              <Logo class="h-12 w-auto" />
            </a>
          </div>

          <nav class="hidden md:flex items-center space-x-1 lg:space-x-4">
            {navLinks.map((link) => (
              <a href={getLink(link.href)} class="px-3 py-2 text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-md transition-colors">
                {link.label}
              </a>
            ))}
            
            <!-- Bouton FR / EN -->
            <div class="ml-4 pl-4 border-l border-slate-700 flex items-center">
              <a href={otherLangPath} class="px-3 py-1.5 text-xs font-bold text-slate-900 bg-white hover:bg-slate-200 rounded uppercase transition-colors">
                {otherLang}
              </a>
            </div>
          </nav>

          <!-- Bouton Mobile (Burger) -->
          <div class="md:hidden flex items-center">
            <button id="mobile-menu-button" class="text-slate-300 hover:text-white focus:outline-none">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Menu Mobile (Caché par défaut) -->
      <div id="mobile-menu" class="md:hidden hidden bg-slate-800">
        <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
          {navLinks.map((link) => (
            <a href={getLink(link.href)} class="block px-3 py-2 text-base font-medium text-slate-300 hover:text-white hover:bg-slate-700 rounded-md">
              {link.label}
            </a>
          ))}
          <a href={otherLangPath} class="block px-3 py-2 text-base font-bold text-slate-900 bg-white rounded-md mt-4 text-center uppercase">
            Passer en {otherLang}
          </a>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>
  </body>
</html>

<script is:inline>
  // Script pour faire fonctionner le menu burger sur mobile
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>