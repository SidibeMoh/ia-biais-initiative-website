{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/en/a-propos/?$",
			"dest": "_render"
		},
		{
			"src": "^/en/aexia/?$",
			"dest": "_render"
		},
		{
			"src": "^/en/api/?$",
			"dest": "_render"
		},
		{
			"src": "^/en/methodologie/?$",
			"dest": "_render"
		},
		{
			"src": "^/en/rapports/?$",
			"dest": "_render"
		},
		{
			"src": "^/en/?$",
			"dest": "_render"
		},
		{
			"src": "^/fr/a-propos/?$",
			"dest": "_render"
		},
		{
			"src": "^/fr/aexia/?$",
			"dest": "_render"
		},
		{
			"src": "^/fr/api/?$",
			"dest": "_render"
		},
		{
			"src": "^/fr/methodologie/?$",
			"dest": "_render"
		},
		{
			"src": "^/fr/rapports/?$",
			"dest": "_render"
		},
		{
			"src": "^/fr/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}